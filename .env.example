# ==========================================
# PITSTOP PLATFORM - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env in local development. Never commit real secrets to Git.

# Global Environment
NODE_ENV=development
PORT=5000

# Backend API Configuration
API_PORT=5000
API_URL=http://localhost:5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Frontend API Client Configuration (Phase 4A - Server-Only, Never NEXT_PUBLIC_*)
PITSTOP_API_BASE_URL=http://localhost:5000/api/v1
# Offline demo fallback: allowed ONLY in development when set to true. Strictly disabled in production.
PITSTOP_ENABLE_DEMO_FALLBACK=false

# Database Configuration (MongoDB Atlas or Local MongoDB)
# - Local MongoDB: mongodb://localhost:27017/pitstop_dev
# - MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/pitstop?retryWrites=true&w=majority
# Note: MONGODB_URI is optional in local development. When omitted, the API runs in API-only mode.
MONGODB_URI=mongodb://localhost:27017/pitstop_dev

# Authentication & JWT Configuration (Phase 3C)
# JWT_SECRET must be at least 32 characters long.
# Example generated via `openssl rand -hex 32` or any 32+ character random string.
JWT_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters_length
JWT_EXPIRES_IN=15m

# Check-in QR Signing Secret (Phase 5B1)
# Used for HMAC-SHA256 signing of venue QR credentials. Must be at least 32 characters.
# If omitted, falls back to JWT_SECRET.
QR_SIGNING_SECRET=replace_with_a_secure_random_qr_key_of_at_least_32_characters_length

# Map Provider Configuration (Future Integration - Mapbox or Google Maps)
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here

# SMS / OTP Provider Configuration (Future Integration - India Supported Provider e.g. Twilio / MSG91)
OTP_PROVIDER=mock
OTP_API_KEY=your_otp_provider_api_key

# Image Storage Configuration (Future Integration - Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
